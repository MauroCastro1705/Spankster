; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Spanker"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Global="*res://global_code/global.gd"
SceneChanger="*res://global_code/SceneChanger.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=600

[file_customization]

folder_colors={
"res://Components/UI_herramienta/": "green",
"res://Components/barras/dolor/": "red",
"res://Components/barras/placer/": "pink",
"res://Components/barras/tolerancia/": "green",
"res://UI/": "green",
"res://assets/": "orange",
"res://global_code/": "pink",
"res://resources/": "yellow"
}

